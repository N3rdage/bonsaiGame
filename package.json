{
  "name": "bonsai-greenhouse",
  "version": "0.1.0",
  "private": true,
  "description": "A cozy bonsai-growing sim. TypeScript rewrite of the GameMaker prototype.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:alt": "playwright test --config playwright.alt.config.ts",
    "test:spike": "playwright test --config playwright.spike.config.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "art:sheets": "node art/sheets.mjs",
    "art:sounds": "node art/sounds.mjs",
    "art:music": "node art/music.mjs",
    "art:site-plan": "node art/sitePlan.mjs",
    "art:viewer": "node art/inked/viewer.mjs",
    "art:paper": "node art/inked/paperSheet.mjs",
    "art:player": "node art/inked/player.mjs",
    "art:shed": "node art/inked/shed.mjs",
    "art:garden": "node art/inked/garden.mjs",
    "art:front-garden": "node art/inked/frontGarden.mjs",
    "art:doors": "node art/inked/doors.mjs",
    "art:lounge": "node art/inked/lounge.mjs",
    "art:hallway": "node art/inked/hallway.mjs",
    "art:study": "node art/inked/study.mjs",
    "art:greenhouse": "node art/inked/greenhouse.mjs",
    "art:placeables": "node art/inked/placeables.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.37.1",
    "@fontsource/caveat": "^5.3.0",
    "phaser": "^4.2.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
