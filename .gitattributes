# Ignore .yy files for language statistics
*.yy linguist-generated=true
 
# force LF for metadata files for merge simplicity
*.gml text eol=lf
*.yy text eol=lf
*.yyp text eol=lf
*.json text eol=lf

# Claude memory is edited by the harness (writes LF) via a junction at
# ~/.claude/projects/<hash>/memory -> .claude-memory; keep LF so memory files
# don't churn between LF/CRLF every session.
.claude-memory/** text eol=lf
# Web project sources: LF everywhere so CI, containers and Windows checkouts agree
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.svg text eol=lf
*.toml text eol=lf
package-lock.json text eol=lf -diff
.gitignore .gitattributes .editorconfig .nvmrc .prettierrc .prettierignore text eol=lf
